@@ -26,6 +26,31 @@ class Wav2Vec2Model(Wav2Vec2Model):
     def __init__(self, config: Wav2Vec2Config):
         super().__init__(config)
 
+    def _run_encoder(self, hidden_states, attention_mask, output_attentions, output_hidden_states):
+        # transformers v5 の Wav2Vec2Encoder は output_hidden_states を無視して hidden_states を返さない
+        # (kijai/ComfyUI-WanVideoWrapper#2052)。v4 が返せばそれを使い、返さなければ各層のフックで集める。
+        collected, hooks = [hidden_states], []
+        if output_hidden_states:
+            hooks = [layer.register_forward_hook(
+                         lambda m, i, o: collected.append(o[0] if isinstance(o, tuple) else o))
+                     for layer in self.encoder.layers]
+        try:
+            encoder_outputs = self.encoder(
+                hidden_states,
+                attention_mask=attention_mask,
+                output_attentions=output_attentions,
+                output_hidden_states=output_hidden_states,
+                return_dict=True,
+            )
+        finally:
+            for h in hooks:
+                h.remove()
+
+        all_hidden_states = getattr(encoder_outputs, "hidden_states", None)
+        if output_hidden_states and all_hidden_states is None:
+            all_hidden_states = tuple(collected)
+        return encoder_outputs.last_hidden_state, all_hidden_states, getattr(encoder_outputs, "attentions", None)
+
     def forward(
         self,
         input_values,
