+def is_speakable(text: str) -> bool:
+    """
+    Return False for fragments that carry no readable text, e.g. a segment that
+    is nothing but emoji, whitespace or punctuation.
+
+    Irodori-TTS uses emoji as delivery/emotion annotations for the sentence they
+    sit in, so an emoji that gets split into its own segment is both useless and
+    harmful: it is sent to the TTS as a standalone utterance and the sentence it
+    was meant to modify loses its annotation. See Build Log #013.
+    """
+    for ch in text:
+        if ch.isalnum():
+            return True
+    return False
+
+
+def merge_unspeakable_segments(
+    sentences: List[str], remaining: str = ""
+) -> Tuple[List[str], str]:
+    """
+    Fold emoji-only (or punctuation-only) fragments back into the sentence that
+    precedes them, so they stay attached to the text they annotate.
+
+    A fragment with no preceding sentence is kept as-is; the caller's buffering
+    will merge it with whatever arrives next.
+    """
+    merged: List[str] = []
+    for sent in sentences:
+        if merged and not is_speakable(sent):
+            merged[-1] = f"{merged[-1]}{sent}"
+        else:
+            merged.append(sent)
+
+    if merged and remaining and not is_speakable(remaining):
+        merged[-1] = f"{merged[-1]}{remaining}"
+        remaining = ""
+
+    return merged, remaining
+
