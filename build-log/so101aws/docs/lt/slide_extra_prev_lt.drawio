        <mxCell id="f6" value="HF Hub へ push&lt;br&gt;→ &lt;b&gt;_COMPLETE&lt;/b&gt; を S3 に" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;arcSize=8;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1">
