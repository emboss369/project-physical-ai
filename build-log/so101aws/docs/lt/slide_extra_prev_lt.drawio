          <mxGeometry x="1030" y="200" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="&lt;b&gt;Spot 中断&lt;/b&gt;（完了マーカーなし）→ 30秒待って再 apply（最大5回）&lt;br&gt;→ S3 のチェックポイントから &lt;b&gt;--resume=true&lt;/b&gt; で続き" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;arcSize=8;fontSize=10;fillColor=#FDF1EF;strokeColor=#D13212;" vertex="1" parent="1">
          <mxGeometry x="960" y="285" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ef_f1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef_f2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
