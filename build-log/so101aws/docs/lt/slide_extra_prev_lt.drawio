        <mxCell id="ef_f4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef_ok" value="正常終了" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1D8102;" edge="1" parent="1" source="f5" target="f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef_67" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1D8102;" edge="1" parent="1" source="f6" target="f7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef_78" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1D8102;" edge="1" parent="1" source="f7" target="f8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef_int" value="&lt;b&gt;中断&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#D13212;exitX=0.118;exitY=1;entryX=0.659;entryY=0;" edge="1" parent="1" source="f4" target="f9">
          <mxGeometry relative="1" as="geometry" x="0.75">
            <Array as="points">
              <mxPoint x="1250" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ef_loop" value="再 apply" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#D13212;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="f9" target="f1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="885" y="308" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="design" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;設計判断 5つ&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#545B64&quot;&gt;壊れたときにどうなるかを先に考える&lt;/font&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; サーバーは使い捨て：パッチを当てず、毎回作り直す&lt;br&gt;&lt;b&gt;②&lt;/b&gt; 消えて困るものは外へ：チェックポイント → S3、モデル → HF Hub&lt;br&gt;&lt;b&gt;③&lt;/b&gt; 永続と使い捨てで state を分ける：bootstrap/ ＋ prevent_destroy&lt;br&gt;&lt;b&gt;④&lt;/b&gt; destroy と S3 削除を紐付けない：&lt;b&gt;_COMPLETE&lt;/b&gt; を確認できたときだけ消す&lt;br&gt;　&lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;「消し忘れて少し残る」方が「消してはいけないものを消す」よりマシ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; SSH より SSM：ポートを開けない。秘密は Parameter Store" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#F8F9FA;strokeColor=#232F3E;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="820" y="348" width="380" height="252" as="geometry" />
        </mxCell>
        <mxCell id="mines" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#D13212&quot;&gt;実際に踏んだ地雷 10個&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#545B64&quot;&gt;うち AWS 由来の4つ&lt;/font&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Spot の容量不足（g6.xlarge）→ placement score で AZ を選び直し、g4dn.xlarge へ&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; GPU Spot のクォータが &lt;b&gt;4 vCPU&lt;/b&gt; ＝ ちょうど1台分。作り直し直後は失敗 → 待って再実行&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; IAM インスタンスプロファイルの反映待ち → provider の自動リトライで吸収&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; &lt;b&gt;`|| true`&lt;/b&gt; で S3 同期が黙って失敗（バケットが実在しなかった）→ bootstrap/ で作る設計に&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;ほか：awscli のパッケージ・conda の利用規約・Python 3.12・extras 名・ドライバの再起動・ホームの権限&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FDF1EF;strokeColor=#D13212;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1215" y="348" width="365" height="252" as="geometry" />
        </mxCell>
        <mxCell id="life_t" value="&lt;b&gt;フィジカルAIを作って動かす流れ&lt;/b&gt;　─ どこをクラウドに出すか" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
