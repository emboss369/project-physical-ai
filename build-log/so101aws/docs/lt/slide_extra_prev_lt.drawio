      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;前回話せなかった1枚：フィジカルAIの「学習」を AWS Spot で使い捨てにする&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;lerobot-aws-infra ─ Terraform ＋ EC2 Spot ＋ S3 で LeRobot の学習を回す（GitHub 公開）&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#232F3E;fontSize=18;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="4" width="1060" height="52" as="geometry" />
        </mxCell>
        <mxCell id="keymsg" value="&lt;b&gt;GPU は自宅に1枚。足りなくなったら、クラウドで使い捨てで借りる&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1090" y="10" width="490" height="40" as="geometry" />
        </mxCell>
