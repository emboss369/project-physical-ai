<mxfile host="Claude Code" type="device">
  <diagram id="slide8_pitfalls" name="slide8_pitfalls"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;止まった点の地図&lt;/b&gt;　1 日で踏んだ 8 つの穴：症状 → 原因 → 対処（どれも「エラーが出ない」か「出ても原因を指さない」）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1560" height="34" as="geometry" /></mxCell><mxCell id="c1" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FDF2E9;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="770" height="170" as="geometry" /></mxCell><mxCell id="c1t" value="&lt;b&gt;① ハード：手首カメラが動くと消える&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="35" y="55" width="740" height="28" as="geometry" /></mxCell><mxCell id="c1a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;ACT が 13 s で停止&lt;br&gt;read failed ×11 → errno=19&lt;br&gt;テレオペ中も切れていた（気づけない）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="30" y="88.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c1b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;カメラ基板のコネクタの緩み&lt;br&gt;journalctl -k：usb 3-2 disconnect が&lt;br&gt;1 日に 3 回、すべてアームが動いた時" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="285" y="88.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c1c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;グルーガンで固定＋結束バンドで&lt;br&gt;ケーブルにたるみを残して留める&lt;br&gt;→ 以後、切断 0 回" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="540" y="88.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c1e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c1a" target="c1b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c1e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c1b" target="c1c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FDF2E9;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="810" y="50" width="770" height="170" as="geometry" /></mxCell><mxCell id="c2t" value="&lt;b&gt;② OS：カメラの番号が入れ替わる&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="825" y="55" width="740" height="28" as="geometry" /></mxCell><mxCell id="c2a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;なし（エラーは出ない）&lt;br&gt;手首と俯瞰の映像が逆のまま&lt;br&gt;ポリシーに渡る" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="820" y="88.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c2b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;/dev/video の番号は USB を挿した順&lt;br&gt;引っ越し前 wrist=0 / front=2&lt;br&gt;→ 引っ越し後は逆" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="1075" y="88.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c2c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;/dev/v4l/by-id/（製品名＋シリアル）で指定&lt;br&gt;アームは udev でシリアル番号から&lt;br&gt;固定名 → 引っ越しでも無修正" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1330" y="88.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c2e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c2a" target="c2b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c2b" target="c2c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=4;html=1;fillColor=#EAF2FB;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="770" height="170" as="geometry" /></mxCell><mxCell id="c3t" value="&lt;b&gt;③ 回線：特定の接続だけが詰まる&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="35" y="235" width="740" height="28" as="geometry" /></mxCell><mxCell id="c3a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;Hub から 207 MB が 10 KB/s&lt;br&gt;fast.com：DL 13 Mbps、負荷時 1.2 s&lt;br&gt;つなぎ直すと一気に速い" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="30" y="268.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c3b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;Wi-Fi の IPv6（省電力を疑って&lt;br&gt;切ったが違った）&lt;br&gt;IPv6 の接続だけ詰まる、と推測" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="285" y="268.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c3c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;nmcli で ipv6.method = disabled&lt;br&gt;→ DL 43 Mbps、負荷時 100 ms&lt;br&gt;E1 の測定条件に明記" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="540" y="268.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c3e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c3a" target="c3b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c3b" target="c3c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=4;html=1;fillColor=#F3EEFB;strokeColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="810" y="230" width="770" height="170" as="geometry" /></mxCell><mxCell id="c4t" value="&lt;b&gt;④ ML：SmolVLA が起動しない&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="825" y="235" width="740" height="28" as="geometry" /></mxCell><mxCell id="c4a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;Visual feature mismatch&lt;br&gt;expects camera1/2/3&lt;br&gt;provides wrist/front" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="820" y="268.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c4b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;読み替えはチェックポイントに保存&lt;br&gt;されているが、lerobot-rollout は&lt;br&gt;CLI の --rename_map しか見ない" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="1075" y="268.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c4c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;学習と同じ --rename_map を渡す&lt;br&gt;front→camera1 / wrist→camera2&lt;br&gt;（逆でもエラーにならない点に注意）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1330" y="268.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c4e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c4a" target="c4b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c4e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c4b" target="c4c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=4;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="770" height="170" as="geometry" /></mxCell><mxCell id="c5t" value="&lt;b&gt;⑤ AWS：Claude が呼べない&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="35" y="415" width="740" height="28" as="geometry" /></mxCell><mxCell id="c5a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;AccessDeniedException&lt;br&gt;「not available for this account」&lt;br&gt;契約・認可・リージョンは全部 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="30" y="448.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c5b" value="&lt;b&gt;原因（3 段）&lt;/b&gt;&lt;br&gt;FTU 未提出 → 契約が自動で結ばれない&lt;br&gt;→ Service Quotas で Claude 5 系の&lt;br&gt;TPM が 0（4 系は 500 万）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="285" y="448.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c5c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;FTU 提出 → create-foundation-&lt;br&gt;model-agreement → jp. Haiku 4.5&lt;br&gt;model_id 1 行で 5.5 に戻せる" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="540" y="448.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c5e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c5a" target="c5b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c5e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c5b" target="c5c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="810" y="410" width="770" height="170" as="geometry" /></mxCell><mxCell id="c6t" value="&lt;b&gt;⑥ 安全：止めたいときに止まらない&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="825" y="415" width="740" height="28" as="geometry" /></mxCell><mxCell id="c6a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;停止キー s を押したのに動き続け、&lt;br&gt;止まったのは 14 s 後&lt;br&gt;（試験 C2）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="820" y="448.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c6b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;日本語入力のままで全角「ｓ」&lt;br&gt;コードは半角 s しか見ていなかった" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="1075" y="448.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c6c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;NFKC 正規化で全角 ｓ・ｙ・ｎ も受付&lt;br&gt;＋ テスト追加&lt;br&gt;finished_at から y/n 待ちも除外" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1330" y="448.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c6e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c6a" target="c6b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c6b" target="c6c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=4;html=1;fillColor=#F8F9FA;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="770" height="170" as="geometry" /></mxCell><mxCell id="c7t" value="&lt;b&gt;⑦ 運用：緊急停止が自分のシェルを狙う&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="35" y="595" width="740" height="28" as="geometry" /></mxCell><mxCell id="c7a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;偽プロセスで試験したら、&lt;br&gt;試験を流したシェルにも SIGINT&lt;br&gt;（その後もう 1 回同じ穴）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="30" y="628.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c7b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;pgrep -f 'bin/lerobot-rollout' は&lt;br&gt;その文字列を含むコマンドライン&lt;br&gt;すべてに一致する" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="285" y="628.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c7c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;^python … /bin/lerobot-rollout だけ&lt;br&gt;3 段停止＋おとりプロセスのテスト&lt;br&gt;（SIGINT / TERM / KILL すべて確認）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="540" y="628.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c7e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c7a" target="c7b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c7e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c7b" target="c7c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=4;html=1;fillColor=#F3EEFB;strokeColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="810" y="590" width="770" height="170" as="geometry" /></mxCell><mxCell id="c8t" value="&lt;b&gt;⑧ AI：判断役が言いすぎる&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="825" y="595" width="740" height="28" as="geometry" /></mxCell><mxCell id="c8a" value="&lt;b&gt;症状&lt;/b&gt;&lt;br&gt;FakeRunner（何も動かない）でも&lt;br&gt;「完了しました！…片付けました」" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="820" y="628.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c8b" value="&lt;b&gt;原因&lt;/b&gt;&lt;br&gt;completed/ok を成功と解釈&lt;br&gt;ポリシーには成功信号がない&lt;br&gt;（入ったかは誰も見ていない）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="1075" y="628.0" width="235" height="88" as="geometry" /></mxCell><mxCell id="c8c" value="&lt;b&gt;対処&lt;/b&gt;&lt;br&gt;get_result に meaning をコードで付与&lt;br&gt;label = success の時だけ成功と言う&lt;br&gt;→ 実機 3/3 判定どおり" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1330" y="628.0" width="240" height="88" as="geometry" /></mxCell><mxCell id="c8e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c8a" target="c8b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#879196;" edge="1" parent="1" source="c8b" target="c8c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="next" value="&lt;b&gt;次の一歩&lt;/b&gt;　① 成功判定をカメラで自動化し operator_label をなくす　② SmolVLA の成功率を回数で数える（今は 1/3）　③ NTP を国内サーバーにして一方向遅延を正しく測る&lt;br&gt;　　　　　④ Haiku 5.5 のクォータを申請する　⑤ 切断・再接続（LWT・永続セッション）を次のスコープに　⑥ 作業が終わったらアクセスキーを無効化する" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="775" width="1560" height="100" as="geometry" /></mxCell><mxCell id="c1l" value="教訓：カメラを使わない操作中の切断には気づけない → journalctl -k の USB disconnect で後から追える" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#ED7100;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="182.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c2l" value="教訓：「挿す順」に依存しない名前で指定する（アームは udev、カメラは /dev/v4l/by-id）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#ED7100;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820.0" y="182.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c3l" value="教訓：怪しいと思った原因（省電力）が原因とは限らない。1 つずつ切り分け、前後を数字で比べる" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#147EBA;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="362.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c4l" value="教訓：保存されている設定と、実行時に読まれる設定は別物。推測で書いた「見込み」はソースで確かめる" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#8C4FFF;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820.0" y="362.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c5l" value="教訓：エラー文が原因を指さないときは、契約・認可・リージョンの次に Service Quotas の上限まで見る" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#01A88D;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="542.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c6l" value="教訓：安全装置は「押したつもりで効いていない入力」を想定してテストする" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#D13212;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820.0" y="542.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c7l" value="教訓：止める道具こそ「関係ないものを止めない」ことをテストする（おとりプロセス）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="722.0" width="750" height="30" as="geometry" /></mxCell><mxCell id="c8l" value="教訓：LLM の報告は、コードが渡す事実（meaning）の範囲に閉じ込める" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fillColor=#8C4FFF;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820.0" y="722.0" width="750" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>