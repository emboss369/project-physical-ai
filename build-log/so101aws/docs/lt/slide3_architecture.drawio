<mxfile host="Claude Code" type="device">
  <diagram id="slide3_architecture" name="slide3_architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;SO-101 × AWS 全体構成&lt;/b&gt;　クラウドは「何をするか」を決め、エッジは「どう安全に動くか」を守る　（2026-11-08 実機で M1 達成）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1560" height="34" as="geometry" /></mxCell><mxCell id="cloud" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="900" height="830" as="geometry" /></mxCell><mxCell id="region" value="Region: ap-northeast-1（東京）" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="210" y="85" width="860" height="780" as="geometry" /></mxCell><mxCell id="home" value="エッジ：自宅（愛媛）Ubuntu PC ＋ SO-101" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="50" width="460" height="830" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;あなた&lt;/b&gt;&lt;br&gt;日本語の指示" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="60" height="60" as="geometry" /></mxCell><mxCell id="n_user" value="&lt;b&gt;scripts/ask.sh&lt;/b&gt;&lt;br&gt;aws lambda invoke&lt;br&gt;{&quot;prompt&quot;:&quot;黄色いブロックを片付けて&quot;}&lt;br&gt;・--cli-read-timeout 320&lt;br&gt;・AWS_MAX_ATTEMPTS=1&lt;br&gt;（CLI の自動再試行で&lt;br&gt;　二重に呼ばれるのを防ぐ）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#F8F9FA;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="15" y="240" width="165" height="120" as="geometry" /></mxCell><mxCell id="lambda" value="&lt;b&gt;Lambda: so101-judge&lt;/b&gt;&lt;br&gt;判断役" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="60" height="60" as="geometry" /></mxCell><mxCell id="n_lambda" value="&lt;b&gt;Strands Agents 1.64.0&lt;/b&gt; / Python 3.12 / x86_64&lt;br&gt;timeout 300 s・memory 512 MB・zip 29 MB&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;：get_robot_status / dispatch_task&lt;br&gt;　　　get_result(wait≤150 s) / stop_robot&lt;br&gt;&lt;b&gt;コードで強制&lt;/b&gt;：許可リスト・IDLE かつ 30 s 以内・&lt;br&gt;　1 呼び出し 1 指令・cmd はタスク名だけ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230" y="245" width="270" height="100" as="geometry" /></mxCell><mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Converse" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="60" height="60" as="geometry" /></mxCell><mxCell id="n_bedrock" value="&lt;b&gt;jp.anthropic.claude-haiku-4-5&lt;/b&gt;&lt;br&gt;推論は東京・大阪のみ（jp. プロファイル）&lt;br&gt;temperature 0 / max_tokens 1024&lt;br&gt;&lt;font color=&quot;#D13212&quot;&gt;Haiku 5.5 はクォータ 0 で不可&lt;/font&gt;&lt;br&gt;FTU 申請 → 契約 → 上限、の 3 関門" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#E6F7F4;strokeColor=#01A88D;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="225" height="85" as="geometry" /></mxCell><mxCell id="role" value="&lt;b&gt;IAM ロール&lt;/b&gt;&lt;br&gt;so101-judge-lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="70" height="40" as="geometry" /></mxCell><mxCell id="n_role" value="&lt;b&gt;最小権限&lt;/b&gt;&lt;br&gt;iot:Publish → cmd だけ&lt;br&gt;iot:GetRetainedMessage → status だけ&lt;br&gt;s3:GetObject → results/* だけ&lt;br&gt;bedrock:InvokeModel → この推論&lt;br&gt;　プロファイル経由だけ（条件キー）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="800" y="245" width="250" height="95" as="geometry" /></mxCell><mxCell id="cw" value="CloudWatch Logs&lt;br&gt;保持 7 日" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws3.cloudwatch;fillColor=#759C3E;gradientColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="380" width="40" height="45" as="geometry" /></mxCell><mxCell id="budget" value="Budgets&lt;br&gt;月 20 USD" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="44" height="44" as="geometry" /></mxCell><mxCell id="iot" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;MQTT5 / mTLS" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="290" y="500" width="70" height="70" as="geometry" /></mxCell><mxCell id="mqtt" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mqtt_protocol;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="40" height="40" as="geometry" /></mxCell><mxCell id="n_topics" value="&lt;b&gt;トピック（thing = so101-edge-01）&lt;/b&gt;&lt;br&gt;so101/&amp;lt;thing&amp;gt;/&lt;b&gt;cmd&lt;/b&gt;　　クラウド→エッジ / QoS1&lt;br&gt;so101/&amp;lt;thing&amp;gt;/&lt;b&gt;status&lt;/b&gt;　エッジ→クラウド / QoS1 / &lt;b&gt;retain&lt;/b&gt;&lt;br&gt;so101/&amp;lt;thing&amp;gt;/&lt;b&gt;result&lt;/b&gt;　エッジ→クラウド / QoS1&lt;br&gt;cmd = {v, cmd_id, type, task, issued_at, ttl_s 60, max_run_s 90}&lt;br&gt;&lt;b&gt;関節角度・座標・速度は載せない&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#F1F7E8;strokeColor=#7AA116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="330" height="100" as="geometry" /></mxCell><mxCell id="policy" value="&lt;b&gt;IoT ポリシー&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.policy;" vertex="1" parent="1"><mxGeometry x="250" y="640" width="44" height="44" as="geometry" /></mxCell><mxCell id="cert" value="&lt;b&gt;X.509 証明書&lt;/b&gt;" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws3.certificate;fillColor=#5294CF;gradientColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="632" width="38" height="52" as="geometry" /></mxCell><mxCell id="n_policy" value="&lt;b&gt;エッジ用ポリシー（最小権限）&lt;/b&gt;&lt;br&gt;Connect: client/${iot:Connection.Thing.ThingName}&lt;br&gt;　条件 Thing.IsAttached = true&lt;br&gt;Publish: status・result / RetainPublish: status&lt;br&gt;Subscribe・Receive: cmd だけ&lt;br&gt;&lt;b&gt;証明書は CSR 方式&lt;/b&gt;：鍵は PC から出さない&lt;br&gt;→ Terraform state に秘密鍵 0 件（確認済み）&lt;br&gt;別クライアント ID は &lt;font color=&quot;#D13212&quot;&gt;NOT_AUTHORIZED(135)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#F8F9FA;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230" y="715" width="300" height="135" as="geometry" /></mxCell><mxCell id="rule" value="&lt;b&gt;IoT ルール&lt;/b&gt;&lt;br&gt;so101_result_to_s3" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rule;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="50" height="50" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;results/" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="60" height="60" as="geometry" /></mxCell><mxCell id="n_rule" value="SELECT * FROM 'so101/+/result'&lt;br&gt;→ key: results/${topic(2)}/${cmd_id}.json&lt;br&gt;error_action → errors/&lt;br&gt;ロール：s3:PutObject だけ＋SourceAccount 条件&lt;br&gt;S3：公開アクセスを全ブロック" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#F1F7E8;strokeColor=#7AA116;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="715" width="290" height="85" as="geometry" /></mxCell><mxCell id="n_tf" value="&lt;b&gt;すべて Terraform&lt;/b&gt;（aws provider 6.72）：IoT 10 件 ＋ Lambda 4 件 ＋ Budgets 1 件。apply は plan を人が見てから" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=10;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="450" height="40" as="geometry" /></mxCell><mxCell id="pc" value="&lt;b&gt;Ubuntu PC&lt;/b&gt;&lt;br&gt;RTX 5060 Ti" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="60" height="58" as="geometry" /></mxCell><mxCell id="agent" value="&lt;b&gt;edge_agent.py&lt;/b&gt;（MQTT5 クライアント、awsiotsdk 1.31.0）&lt;br&gt;① 形が不正 → rejected/invalid&lt;br&gt;② 既知の cmd_id → 再実行しない（再送 or 無視）&lt;br&gt;③ stop → 実行中なら止める&lt;br&gt;④ issued_at から ttl_s 超え → expired&lt;br&gt;⑤ 許可リスト外 → unknown_task&lt;br&gt;⑥ RUNNING / STOPPING → busy&lt;br&gt;⑦ IDLE → 実行開始&lt;br&gt;状態：IDLE → RUNNING → (STOPPING) → IDLE&lt;br&gt;status を 10 s ごと retain 送信・停止キー s（全角可）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#EAF2FB;strokeColor=#147EBA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="95" width="315" height="175" as="geometry" /></mxCell><mxCell id="runner" value="&lt;b&gt;PolicyRunner&lt;/b&gt;（別プロセスグループ）&lt;br&gt;scripts/rollout_smolvla.sh → lerobot-rollout --duration 20&lt;br&gt;停止：SIGINT →10 s→ SIGTERM →10 s→ SIGKILL&lt;br&gt;max_run_s はエッジ上限 120 s で切り詰め" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#EAF2FB;strokeColor=#147EBA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="300" width="315" height="80" as="geometry" /></mxCell><mxCell id="policyml" value="&lt;b&gt;SmolVLA&lt;/b&gt;（450M、学習 64×20k、150 エピソード）&lt;br&gt;30 Hz 制御・50 ステップごとに推論 約 103 ms&lt;br&gt;--rename_map front→camera1 / wrist→camera2&lt;br&gt;task: &quot;Put the yellow lego block into the white case&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F3EEFB;strokeColor=#8C4FFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="410" width="315" height="80" as="geometry" /></mxCell><mxCell id="arm" value="&lt;b&gt;SO-101 フォロワーアーム&lt;/b&gt;&lt;br&gt;/dev/so101_follower（udev 固定名）&lt;br&gt;終了時：開始姿勢へ 3 s で戻る → 脱力&lt;br&gt;→ 開始姿勢は「休止の姿勢」が前提" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="520" width="315" height="75" as="geometry" /></mxCell><mxCell id="cam1" value="手首カメラ&lt;br&gt;Innomaker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.camera;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="40" height="40" as="geometry" /></mxCell><mxCell id="cam2" value="俯瞰カメラ&lt;br&gt;C920" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.camera;" vertex="1" parent="1"><mxGeometry x="1160" y="610" width="40" height="40" as="geometry" /></mxCell><mxCell id="n_edge" value="&lt;b&gt;エッジの前提条件（実測で決めた）&lt;/b&gt;&lt;br&gt;・カメラは /dev/v4l/by-id の固定パス（番号は挿す順で入れ替わる）&lt;br&gt;・Wi-Fi 2.4 GHz・IPv6 無効（有効だと負荷時 1.2 s 遅延）&lt;br&gt;・手首カメラのコネクタをグルーで固定（動くと USB 切断）&lt;br&gt;・emergency_stop.sh：python 実行の lerobot-rollout だけ狙う&lt;br&gt;・起動 15 s ＋ 動作 20 s ＋ 後始末 5 s ≒ 40 s / 回" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F8F9FA;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1150" y="690" width="415" height="120" as="geometry" /></mxCell><mxCell id="principle" value="原則：クラウドが送るのはタスク名だけ ／ 停止・安全はエッジ ／ ガードはプロンプトでなくコードで" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#D13212;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1150" y="825" width="415" height="40" as="geometry" /></mxCell><mxCell id="e1" value="① invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="user" target="lambda"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="② Converse（tool use）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="lambda" target="bedrock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="③ GetRetainedMessage(status)&lt;br&gt;④ Publish(cmd, QoS1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_lambda" target="iot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="⑤ cmd（mTLS / QoS1）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7AA116;strokeWidth=3;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_topics" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1105" y="480" /><mxPoint x="1105" y="240" /></Array></mxGeometry></mxCell><mxCell id="e5" value="⑨ status(retain) / result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#147EBA;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#F