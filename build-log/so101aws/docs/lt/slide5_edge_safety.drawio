<mxfile host="Claude Code" type="device">
  <diagram id="slide5_edge_safety" name="slide5_edge_safety"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;エッジが守るもの&lt;/b&gt;　指令の処理順 ／ 状態遷移 ／ 止め方 ― どれもクラウドからは上書きできない" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1560" height="34" as="geometry" /></mxCell><mxCell id="pA" value="A. 指令の処理順（上から評価、最初に当たったもので終わる）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#147EBA;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="560" height="830" as="geometry" /></mxCell><mxCell id="in" value="&lt;b&gt;cmd 受信&lt;/b&gt;（MQTT5 QoS1）&lt;br&gt;received_at を記録" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#147EBA;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="180" height="40" as="geometry" /></mxCell><mxCell id="d1" value="① 形が正しい？ v=1？" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="180" height="60" as="geometry" /></mxCell><mxCell id="d2" value="② 既知の cmd_id？" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="180" height="60" as="geometry" /></mxCell><mxCell id="d3" value="③ type = stop？" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="180" height="60" as="geometry" /></mxCell><mxCell id="d4" value="④ 期限切れ？&lt;br&gt;(now − issued_at &amp;gt; ttl_s)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="180" height="70" as="geometry" /></mxCell><mxCell id="d5" value="⑤ 許可リスト内？" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="180" height="60" as="geometry" /></mxCell><mxCell id="d6" value="⑥ RUNNING / STOPPING？" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="180" height="60" as="geometry" /></mxCell><mxCell id="go" value="&lt;b&gt;⑦ 実行開始&lt;/b&gt;&lt;br&gt;max_run_s = min(指令, 120 s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#1D8102;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="180" height="45" as="geometry" /></mxCell><mxCell id="o1" value="rejected / &lt;b&gt;invalid&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="150" height="40" as="geometry" /></mxCell><mxCell id="o2" value="&lt;b&gt;再実行しない&lt;/b&gt;&lt;br&gt;完了済み → 前回 result を再送&lt;br&gt;実行中 → 何もしない" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="190" height="60" as="geometry" /></mxCell><mxCell id="o3" value="RUNNING なら止める（cloud_stop）&lt;br&gt;IDLE なら無視 ／ &lt;b&gt;TTL より先&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="300" y="335" width="190" height="50" as="geometry" /></mxCell><mxCell id="o4" value="rejected / &lt;b&gt;expired&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="300" y="435" width="150" height="40" as="geometry" /></mxCell><mxCell id="o5" value="rejected / &lt;b&gt;unknown_task&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="150" height="40" as="geometry" /></mxCell><mxCell id="o6" value="rejected / &lt;b&gt;busy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="300" y="620" width="150" height="40" as="geometry" /></mxCell><mxCell id="nA" value="&lt;b&gt;順番に意味がある（テストで固定）&lt;/b&gt;&lt;br&gt;・② が ④ より先：完了済みの指令が 1 時間遅れて来ても「期限切れ」でなく前回の結果&lt;br&gt;・③ が ④ より先：古い停止指令でも止める（安全側）&lt;br&gt;・⑤ が ⑥ より先：実行中でも許可外は unknown_task&lt;br&gt;・重複排除はメモリ上の直近 100 件（再起動で忘れる → TTL 60 s が窓を狭める）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#F8F9FA;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="255" y="690" width="315" height="180" as="geometry" /></mxCell><mxCell id="a0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;" edge="1" parent="1" source="in" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a1" value="OK" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;fontSize=9;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="未知" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;fontSize=9;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="run_task" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;fontSize=9;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="期限内" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;fontSize=9;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="許可" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#147EBA;fontSize=9;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="IDLE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1D8102;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="d6" target="go"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b1" value="NG" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;" edge="1" parent="1" source="d1" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b2" value="既知" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;fontSize=9;" edge="1" parent="1" source="d2" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b3" value="stop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;fontSize=9;" edge="1" parent="1" source="d3" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b4" value="超過" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;" edge="1" parent="1" source="d4" target="o4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b5" value="許可外" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;" edge="1" parent="1" source="d5" target="o5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b6" value="実行中" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;" edge="1" parent="1" source="d6" target="o6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pB" value="B. 状態遷移（status は retain、10 s ごと＋変化時に送信）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#F1F7E8;strokeColor=#7AA116;fontColor=#3F6E0B;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="470" height="440" as="geometry" /></mxCell><mxCell id="sI" value="&lt;b&gt;IDLE&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#1D8102;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="120" height="60" as="geometry" /></mxCell><mxCell id="sR" value="&lt;b&gt;RUNNING&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#147EBA;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="130" height="60" as="geometry" /></mxCell><mxCell id="sS" value="&lt;b&gt;STOPPING&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ED7100;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="130" height="60" as="geometry" /></mxCell><mxCell id="t1" value="⑦ に到達" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;strokeColor=#147EBA;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sI" target="sR"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t2" value="exit 0 → completed/ok&lt;br&gt;exit ≠ 0 → aborted/runner_error" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1D8102;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sR" target="sI"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="230" /><mxPoint x="700" y="230" /></Array></mxGeometry></mxCell><mxCell id="t3" value="s キー（operator_stop）&lt;br&gt;stop 指令（cloud_stop）&lt;br&gt;max_run_s 超過（timeout）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;align=left;" edge="1" parent="1" source="sR" target="sS"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t4" value="停止完了 → aborted/&amp;lt;理由&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sS" target="sI"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nB" value="&lt;b&gt;クラウド側の扱い&lt;/b&gt;&lt;br&gt;・status の ts が 30 s より古い → UNKNOWN（送らない）&lt;br&gt;・LWT は使わない：エッジが止まっても retain は残る → 古さで判断&lt;br&gt;・retain の読み取りは 0.8 s 遅れることがあった（E2 で 1/5）&lt;br&gt;　→ IDLE に見えても実は RUNNING ありうる → エッジの ⑥ busy が最後の砦" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFFFFF;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="615" y="385" width="440" height="95" as="geometry" /></mxCell><mxCell id="pC" value="C. 止め方（実機で実測：SIGINT → 終了 5.6 s）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1090" y="50" width="490" height="440" as="geometry" /></mxCell><mxCell id="k1" value="&lt;b&gt;SIGINT&lt;/b&gt;（lerobot-rollout 本体だけに）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1110" y="95" width="200" height="40" as="geometry" /></mxCell><mxCell id="k2" value="&lt;b&gt;SIGTERM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FDE3D3;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1110" y="175" width="200" height="40" as="geometry" /></mxCell><mxCell id="k3" value="&lt;b&gt;SIGKILL&lt;/b&gt;（プロセスグループ全体）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D13212;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1110" y="255" width="200" height="40" as="geometry" /></mxCell><mxCell id="k4" value="&lt;b&gt;電源を切る&lt;/b&gt;（最終手段）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1110" y="335" width="200" height="40" as="geometry" /></mxCell><mxCell id="ka" value="10 s 待って終わらなければ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kb" value="10 s 待って終わらなければ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D13212;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc" value="それでも動くなら" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kd" value="&lt;b&gt;SIGINT / SIGTERM / 時間切れ のとき&lt;/b&gt;&lt;br&gt;lerobot-rollout の後始末：&lt;br&gt;① 推論停止&lt;br&gt;② 開始姿勢へ 3 s で補間して戻る&lt;br&gt;③ 切断 → &lt;b&gt;トルクを切って脱力&lt;/b&gt;&lt;br&gt;→ 開始姿勢を「休止の姿勢」にする運用&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D13212&quot;&gt;&lt;b&gt;例外&lt;/b&gt;：戻る途中で失敗（カメラ切断など）すると、その場で脱力&lt;/font&gt;&lt;br&gt;SIGKILL は後始末なし（力を保つと推測）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFFFFF;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1325" y="95" width="245" height="280" as="geometry" /></mxCell><mxCell id="ke" value="入口は 3 つ：edge の s キー（全角 ｓ も可）／ クラウドの stop ／ 独立した emergency_stop.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1110" y="400" width="460" height="75" as="geometry" /></mxCell><mxCell id="pD" value="D. 実機と試験で確かめたこと（2026-11-08）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#F8F9FA;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="980" height="370" as="geometry" /></mxCell><mxCell id="ev1" value="&lt;b&gt;試験 A：20 s で自然終了&lt;/b&gt;&lt;br&gt;Duration limit reached → 開始姿勢 3 s → 脱力&lt;br&gt;exit = 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="300" height="70" as="geometry" /></mxCell><mxCell id="ev2" value="&lt;b&gt;試験 B：emergency_stop.sh&lt;/b&gt;&lt;br&gt;21:56:56.828 SIGINT → 21:57:02.440 停止&lt;br&gt;= 5.6 s（SIGINT 1 回で止まった）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="940" y="550" width="300" height="70" as="geometry" /></mxCell><mxCell id="ev3" value="&lt;b&gt;試験 C2：s キーで停止&lt;/b&gt;&lt;br&gt;STOPPING → result まで 5.5 s&lt;br&gt;aborted / operator_stop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1260" y="550" width="300" height="70" as="geometry" /></mxCell><mxCell id="bug1" value="&lt;b&gt;見つけた穴 1：全角「ｓ」で止まらなかった&lt;/b&gt;&lt;br&gt;日本語入力のまま押した ｓ が無視され、止まったのは 14 s 後&lt;br&gt;→ NFKC 正規化で全角も受け付ける＋テスト追加" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="460" height="70" as="geometry" /></mxCell><mxCell id="bug2" value="&lt;b&gt;見つけた穴 2：緊急停止が自分のシェルまで狙った&lt;/b&gt;&lt;br&gt;pgrep -f 'bin/lerobot-rollout' が文字列を含むシェルにも一致&lt;br&gt;→ 「python で …/bin/lerobot-rollout」だけに一致させる＋おとりテスト" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1100" y="640" width="460" height="70" as="geometry" /></mxCell><mxCell id="tests" value="&lt;b&gt;自動テスト 101 件&lt;/b&gt;（エッジ 73 ＝ 処理順・状態遷移・重複・停止キー・PolicyRunner の 3 段停止・MQTT・緊急停止 ／ 判断役 28 ＝ ガード全パターン・待ち時間上限・言いすぎ防止）　ruff・shellcheck エラー 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="940" height="60" as="geometry" /></mxCell><mxCell id="msg" value="クラウドの max_run_s が 3600 s でも、エッジの上限 120 s で止まる（テストで確認）。&lt;b&gt;決めるのはクラウド、守るのはエッジ。&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#D13212;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="805" width="940" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>