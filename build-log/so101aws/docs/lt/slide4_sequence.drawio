<mxfile host="Claude Code" type="device">
  <diagram id="slide4_sequence" name="slide4_sequence"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;1 回の依頼の流れ&lt;/b&gt;　「黄色いブロックを片付けて」→ 報告まで 49.6 s（2026-11-08 23:03 実機 #3、オペレーター判定 success）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1560" height="34" as="geometry" /></mxCell><mxCell id="h_user" value="&lt;b&gt;あなた&lt;/b&gt;&lt;br&gt;ask.sh" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="70" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_lambda" value="&lt;b&gt;Lambda 判断役&lt;/b&gt;&lt;br&gt;Strands" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="280" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_bedrock" value="&lt;b&gt;Bedrock&lt;/b&gt;&lt;br&gt;Haiku 4.5 (jp.)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_iot" value="&lt;b&gt;IoT Core&lt;/b&gt;&lt;br&gt;MQTT5" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="680" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_s3" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;results/" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="860" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_edge" value="&lt;b&gt;edge_agent&lt;/b&gt;&lt;br&gt;Ubuntu PC" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="40" height="40" as="geometry" /></mxCell><mxCell id="h_arm" value="&lt;b&gt;lerobot-rollout&lt;/b&gt;&lt;br&gt;SmolVLA ＋ SO-101" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="50" width="140" height="40" as="geometry" /></mxCell><mxCell id="l_user" style="endArrow=none;dashed=1;html=1;strokeColor=#879196;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="125" as="sourcePoint" /><mxPoint x="90" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_lambda" style="endArrow=none;dashed=1;html=1;strokeColor=#ED7100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="125" as="sourcePoint" /><mxPoint x="300" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_bedrock" style="endArrow=none;dashed=1;html=1;strokeColor=#01A88D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="125" as="sourcePoint" /><mxPoint x="500" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_iot" style="endArrow=none;dashed=1;html=1;strokeColor=#7AA116;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="125" as="sourcePoint" /><mxPoint x="700" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_s3" style="endArrow=none;dashed=1;html=1;strokeColor=#7AA116;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="125" as="sourcePoint" /><mxPoint x="880" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_edge" style="endArrow=none;dashed=1;html=1;strokeColor=#147EBA;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="125" as="sourcePoint" /><mxPoint x="1080" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l_arm" style="endArrow=none;dashed=1;html=1;strokeColor=#D13212;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="125" as="sourcePoint" /><mxPoint x="1300" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m1" value="1. invoke {prompt:&quot;黄色いブロックを片付けて&quot;}" style="html=1;endArrow=block;strokeColor=#232F3E;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="150" as="sourcePoint" /><mxPoint x="300" y="150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="2. Converse（system prompt ＋ tools×4）" style="html=1;endArrow=block;strokeColor=#01A88D;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="185" as="sourcePoint" /><mxPoint x="500" y="185" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m3" value="3. tool_use: get_robot_status" style="html=1;endArrow=open;dashed=1;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="215" as="sourcePoint" /><mxPoint x="300" y="215" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="4. GetRetainedMessage(status) → IDLE / age &amp;lt; 30 s" style="html=1;endArrow=block;strokeColor=#ED7100;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="700" y="250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="5. tool_use: dispatch_task(&quot;pick_yellow_block&quot;)" style="html=1;endArrow=open;dashed=1;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="285" as="sourcePoint" /><mxPoint x="300" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="g1" value="&lt;b&gt;6. コードのガード&lt;/b&gt;&lt;br&gt;許可リスト？ IDLE かつ 30 s 以内？&lt;br&gt;この呼び出しで 1 件目？→ すべて OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="175" height="55" as="geometry" /></mxCell><mxCell id="m7" value="7. Publish(cmd, QoS1)　issued_at = Lambda の時計" style="html=1;endArrow=block;strokeColor=#ED7100;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="370" as="sourcePoint" /><mxPoint x="700" y="370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="8. cmd 配送（mTLS）　&lt;b&gt;48 ms&lt;/b&gt;（received_at − issued_at、時計ずれ ±30 ms 込み）" style="html=1;endArrow=block;strokeColor=#7AA116;strokeWidth=3;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="400" as="sourcePoint" /><mxPoint x="1080" y="400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="g2" value="&lt;b&gt;9. 処理順 ①〜⑦&lt;/b&gt; → started&lt;br&gt;status = RUNNING（retain）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#EAF2FB;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="900" y="415" width="175" height="40" as="geometry" /></mxCell><mxCell id="m10" value="10. PolicyRunner 起動（別プロセスグループ）" style="html=1;endArrow=block;strokeColor=#147EBA;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="470" as="sourcePoint" /><mxPoint x="1300" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="act" value="" style="rounded=0;html=1;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1292" y="475" width="16" height="200" as="geometry" /></mxCell><mxCell id="t_boot" value="&lt;b&gt;起動 ≒ 15 s&lt;/b&gt;：モデル読込・カメラ 2 台・アーム接続" style="text;html=1;align=left;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1315" y="480" width="280" height="20" as="geometry" /></mxCell><mxCell id="t_run" value="&lt;b&gt;動作 20 s&lt;/b&gt;（--duration 20）：30 Hz 制御 567 tick、&lt;br&gt;50 tick ごとに推論 約 103 ms → 遅延警告 11 回" style="text;html=1;align=left;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1315" y="525" width="280" height="35" as="geometry" /></mxCell><mxCell id="t_tear" value="&lt;b&gt;後始末 ≒ 5 s&lt;/b&gt;：開始姿勢へ 3 s → 切断 → 脱力 / exit 0" style="text;html=1;align=left;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1315" y="600" width="280" height="20" as="geometry" /></mxCell><mxCell id="t_sum" value="実行時間 39.7 s（started_at → finished_at）" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="1315" y="645" width="280" height="20" as="geometry" /></mxCell><mxCell id="m11" value="11. 終了コード 0" style="html=1;endArrow=open;dashed=1;strokeColor=#D13212;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="690" as="sourcePoint" /><mxPoint x="1080" y="690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="g3" value="&lt;b&gt;12. オペレーターが目で判定&lt;/b&gt;（--label）&lt;br&gt;y → operator_label = success" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#EAF2FB;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="190" height="40" as="geometry" /></mxCell><mxCell id="m13" value="13. result {completed, ok, success}　＋ status = IDLE" style="html=1;endArrow=block;strokeColor=#147EBA;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="760" as="sourcePoint" /><mxPoint x="700" y="760" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="14. IoT ルール → PutObject" style="html=1;endArrow=block;strokeColor=#7AA116;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="785" as="sourcePoint" /><mxPoint x="880" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="15. get_result：GetObject を 2 s ごと（最大 150 s）" style="html=1;endArrow=block;strokeColor=#ED7100;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="810" as="sourcePoint" /><mxPoint x="880" y="810" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="16. tool_result ＋ meaning（成否をどこまで言えるか）" style="html=1;endArrow=block;strokeColor=#01A88D;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="835" as="sourcePoint" /><mxPoint x="500" y="835" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="17. reply「黄色いブロックを片付けました。…オペレーターが成功と判定」" style="html=1;endArrow=block;strokeColor=#232F3E;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="865" as="sourcePoint" /><mxPoint x="90" y="865" as="targetPoint" /></mxGeometry></mxCell><mxCell id="side" value="&lt;b&gt;ここがポイント&lt;/b&gt;&lt;br&gt;・LLM が決めるのは 3 と 5 だけ（どのツールを呼ぶか）&lt;br&gt;・6 と 9 は&lt;b&gt;コード&lt;/b&gt;が決める。LLM は越えられない&lt;br&gt;・Lambda は完了を&lt;b&gt;待たずに&lt;/b&gt;送り、S3 を見に行く&lt;br&gt;・16 の meaning：completed/ok は「動作が終わった」だけ&lt;br&gt;　label が success でなければ「片付けた」と言わせない&lt;br&gt;・3 回とも同じ順：status → dispatch(1 回) → result" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="355" height="135" as="geometry" /></mxCell><mxCell id="timeline" value="&lt;b&gt;呼び出し全体 49.6 s の内訳（概算）&lt;/b&gt;&lt;br&gt;判断（2〜5）≒ 2 s ／ 配送 48 ms ／ 起動 15 s ／ 動作 20 s ／ 後始末 5 s ／ 判定入力 数 s ／ 報告 ≒ 2 s" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F8F9FA;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="520" y="600" width="360" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>