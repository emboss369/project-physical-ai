<mxfile host="Claude Code" type="device">
  <diagram id="slide7_measurements" name="slide7_measurements"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;実測値&lt;/b&gt;　M2（E1 配送遅延 20 回）・加点（E2 重複 5 回）・M1（実機 3 回）　すべて 2026-11-08、愛媛の自宅 Wi-Fi から東京リージョン" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1560" height="34" as="geometry" /></mxCell><mxCell id="pA" value="A. E1：cmd の配送遅延（received_at − issued_at、ms）　n = 20、FakeRunner" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#F1F7E8;strokeColor=#7AA116;fontColor=#3F6E0B;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="760" height="430" as="geometry" /></mxCell><mxCell id="axis" style="endArrow=none;html=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="430" as="sourcePoint" /><mxPoint x="680" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="med" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D13212;strokeWidth=2;fontSize=10;fontColor=#D13212;labelBackgroundColor=#FFFFFF;align=right;" edge="1" parent="1"><mxGeometry x="0.9" relative="1" as="geometry"><mxPoint x="50" y="292" as="sourcePoint" /><mxPoint x="680" y="292" as="targetPoint" /><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p90" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#ED7100;strokeWidth=1;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry x="0.9" relative="1" as="geometry"><mxPoint x="50" y="222" as="sourcePoint" /><mxPoint x="680" y="222" as="targetPoint" /><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="b0" value="237" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalA