rent="1"><mxGeometry x="308" y="303" width="24" height="127" as="geometry" /></mxCell><mxCell id="b9" value="189" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="339" y="241" width="24" height="189" as="geometry" /></mxCell><mxCell id="b10" value="214" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="216" width="24" height="214" as="geometry" /></mxCell><mxCell id="b11" value="97" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="401" y="333" width="24" height="97" as="geometry" /></mxCell><mxCell id="b12" value="106" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="432" y="324" width="24" height="106" as="geometry" /></mxCell><mxCell id="b13" value="137" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="463" y="293" width="24" height="137" as="geometry" /></mxCell><mxCell id="b14" value="114" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="494" y="316" width="24" height="114" as="geometry" /></mxCell><mxCell id="b15" value="183" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="525" y="247" width="24" height="183" as="geometry" /></mxCell><mxCell id="b16" value="183" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="556" y="247" width="24" height="183" as="geometry" /></mxCell><mxCell id="b17" value="133" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="587" y="297" width="24" height="133" as="geometry" /></mxCell><mxCell id="b18" value="81" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="618" y="349" width="24" height="81" as="geometry" /></mxCell><mxCell id="b19" value="81" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=top;verticalAlign=bottom;fontSize=8;" vertex="1" parent="1"><mxGeometry x="649" y="349" width="24" height="81" as="geometry" /></mxCell><mxCell id="statsA" value="&lt;b&gt;最小 65 ／ 中央値 137.5 ／ p90 208 ／ 最大 237 ／ 平均 145.7 ms&lt;/b&gt;　（1〜20 回目の順、送信間隔 1 s ＋ 実行 1 s）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="720" height="30" as="geometry" /></mxCell><mxCell id="noteA" value="条件：Wi-Fi 2.4 GHz・IPv6 無効・省電力オフ&lt;br&gt;送信 = send_cmd.py（boto3 iot-data publish）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="290" height="45" as="geometry" /></mxCell><mxCell id="pB" value="B. 何を測ったのか（測り方で意味が変わる）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#147EBA;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="780" height="430" as="geometry" /></mxCell><mxCell id="pcS" value="send_cmd.py&lt;br&gt;（自宅 PC）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="44" height="42" as="geometry" /></mxCell><mxCell id="iotB" value="IoT Core&lt;br&gt;（東京）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="1080" y="100" width="44" height="44" as="geometry" /></mxCell><mxCell id="pcE" value="edge_agent&lt;br&gt;（同じ PC）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="44" height="42" as="geometry" /></mxCell><mxCell id="eB1" value="HTTPS publish（上り）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7AA116;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pcS" target="iotB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eB2" value="MQTT（下り）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7AA116;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="iotB" target="pcE"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tB1" value="&lt;b&gt;E1（段階 2）＝ 往復&lt;/b&gt;：同じ PC の時計で issued と received を付ける → 時計ずれゼロ。ただし上り＋下りで、一方向ではない" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1390" y="90" width="180" height="90" as="geometry" /></mxCell><mxCell id="lamB" value="Lambda&lt;br&gt;（東京）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="44" height="44" as="geometry" /></mxCell><mxCell id="iotC" value="IoT Core" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="1080" y="230" width="44" height="44" as="geometry" /></mxCell><mxCell id="pcF" value="edge_agent&lt;br&gt;（自宅 PC）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1320" y="230" width="44" height="42" as="geometry" /></mxCell><mxCell id="eC1" value="AWS 内" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lamB" target="iotC"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eC2" value="MQTT（下り）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7AA116;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="iotC" target="pcF"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tB2" value="&lt;b&gt;M1 の 48〜148 ms ＝ 一方向&lt;/b&gt;：Lambda の時計 vs 自宅 PC の時計。PC は NTP が海外サーバーで ±30 ms ずれ → &lt;b&gt;参考値&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1390" y="220" width="180" height="90" as="geometry" /></mxCell><mxCell id="netB" value="&lt;b&gt;回線の前提（同じ日に直した）&lt;/b&gt;&lt;br&gt;IPv6 有効のとき：DL 13 Mbps、負荷時レイテンシ &lt;font color=&quot;#D13212&quot;&gt;&lt;b&gt;1.2 s&lt;/b&gt;&lt;/font&gt;、HF の DL が 10 KB/s で詰まる&lt;br&gt;IPv6 無効にしたあと：DL 43 Mbps、負荷時 &lt;b&gt;100 ms&lt;/b&gt;（fast.com、各 1 回）&lt;br&gt;→ 直す前に E1 を測っていたら、数字は回線の不調を測っていた" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="750" height="80" as="geometry" /></mxCell><mxCell id="netB2" value="SmolVLA 側：30 Hz 制御のうち 50 tick に 1 回だけ推論 約 103 ms（1.67 s ごとに 0.1 s の引っかかり）。ACT は推論 1.35 ms で警告 0 回" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="750" height="40" as="geometry" /></mxCell><mxCell id="pC" value="C. M1：日本語の指示 → 実機 → 報告（3 回）" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="760" height="380" as="geometry" /></mxCell><mxCell id="mh" value="&lt;b&gt;#　result　　　判定　　Lambda→エッジ　実行　　全体　　判断役の報告&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="720" height="22" as="geometry" /></mxCell><mxCell id="m1r" value="1　completed/ok　&lt;font color=&quot;#D13212&quot;&gt;fail&lt;/font&gt;　　148 ms　　　39.9 s　57.9 s　「失敗と判定しました」" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="720" height="30" as="geometry" /></mxCell><mxCell id="m2r" value="2　completed/ok　&lt;font color=&quot;#D13212&quot;&gt;fail&lt;/font&gt;　　100 ms　　　39.9 s　51.8 s　「失敗と判定しました」" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="720" height="30" as="geometry" /></mxCell><mxCell id="m3r" value="&lt;b&gt;3　completed/ok　&lt;font color=&quot;#1D8102&quot;&gt;success&lt;/font&gt;　48 ms　　39.7 s　49.6 s　「片付けました。オペレーターが成功と判定」&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="720" height="30" as="geometry" /></mxCell><mxCell id="mres" value="&lt;b&gt;指示 → 動作 → 報告：3/3 通った ／ 掴めた：1/3&lt;/b&gt;　ツール順は 3 回とも status → dispatch(1) → result" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="720" height="25" as="geometry" /></mxCell><mxCell id="tl" value="&lt;b&gt;1 回 ≒ 40 s の内訳&lt;/b&gt;（15 px = 1 s）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="300" height="20" as="geometry" /></mxCell><mxCell id="tl1" value="起動 15 s&lt;br&gt;モデル・カメラ・アーム" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#AAB7B8;fontColor=#232F3E;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="715" width="225" height="40" as="geometry" /></mxCell><mxCell id="tl2" value="動作 20 s（30 Hz・SmolVLA）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#D13212;fontColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="285" y="715" width="300" height="40" as="geometry" /></mxCell><mxCell id="tl3" value="後始末 5 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ED7100;fontColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="585" y="715" width="75" height="40" as="geometry" /></mxCell><mxCell id="tl4" value="＋判定入力" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFFFFF;fontColor=#232F3E;strokeColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="715" width="90" height="40" as="geometry" /></mxCell><mxCell id="tlN" value="配送の 48〜148 ms は、この棒の幅にすると 1〜2 px。&lt;b&gt;待ち時間の大半はクラウドではなくエッジの起動と動作&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="720" height="40" as="geometry" /></mxCell><mxCell id="tlC" value="同日のポリシー比較（印象・回数未集計）：SmolVLA ＞ ACT day3 ≒ ACT day1。同じ 150 エピソードで SmolVLA を採用" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="720" height="40" as="geometry" /></mxCell><mxCell id="pD" value="D. E2：同じ cmd_id を 2 回送る（5 回）／ 費用まわり" style="swimlane;startSize=26;html=1;fontSize=12;fillColor=#F8F9FA;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="780" height="380" as="geometry" /></mxCell><mxCell id="e2a" value="&lt;b&gt;1 回目の測定：4/5&lt;/b&gt;&lt;br&gt;判定に retain の status を使っていた → #4 は 0.8 s 後でも IDLE と読めて NG&lt;br&gt;エッジのログは 5 回とも started → duplicate:ignored → duplicate:resent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFF7D6;strokeColor=#B7791F;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="360" height="90" as="geometry" /></mxCell><mxCell id="e2b" value="&lt;b&gt;測り直し：5/5 合格&lt;/b&gt;&lt;br&gt;判定を「重複の送信時刻が result の started_at〜finished_at に入るか」に変更&lt;br&gt;→ 不具合はエッジでなく&lt;b&gt;テストの判定&lt;/b&gt;だった" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F4E1;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="360" height="90" as="geometry" /></mxCell><mxCell id="e2arrow" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="e2a" target="e2b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bud" value="Budgets 月 20 USD" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;" vertex="1" parent="1"><mxGeometry x="840" y="660" width="44" height="44" as="geometry" /></mxCell><mxCell id="cost" value="&lt;b&gt;費用の考え方&lt;/b&gt;（実額は未集計）&lt;br&gt;・Lambda：呼んだときだけ（1 回 50〜60 s × 512 MB）&lt;br&gt;・Bedrock Haiku 4.5：1 依頼あたり数千トークン程度（推測）&lt;br&gt;・IoT Core：接続分＋メッセージ（今回は数十件）&lt;br&gt;・アラート：実績 80 % ／ 予測 100 % でメール" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="910" y="650" width="320" height="105" as="geometry" /></mxCell><mxCell id="quota" value="&lt;b&gt;Bedrock の 3 関門&lt;/b&gt;&lt;br&gt;① FTU フォーム（未提出だった）&lt;br&gt;② 利用契約：呼んでも自動で結ばれず → create-foundation-model-agreement で 50 s&lt;br&gt;③ &lt;font color=&quot;#D13212&quot;&gt;Claude 5 系のクォータ 0&lt;/font&gt; → Haiku 4.5（上限 500 万 TPM）へ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#E6F7F4;strokeColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1250" y="650" width="310" height="105" as="geometry" /></mxCell><mxCell id="takeD" value="数字は「何を、どの時計で、どの回線条件で」測ったかとセットで出す" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820" y="780" width="740" height="70" as="geometry" /></mxCell><mxCell id="med_lbl" value="中央値 137.5" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#D13212;" vertex="1" parent="1"><mxGeometry x="684" y="281" width="95" height="22" as="geometry" /></mxCell><mxCell id="p90_lbl" value="p90 208" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="684" y="211" width="95" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>